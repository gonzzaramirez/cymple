# Base de datos PostgreSQL (Prisma)
DATABASE_URL="postgresql://postgres:REEMPLAZAR_PASSWORD@HOST:5432/gymple_bd"

# API
PORT=3080
NODE_ENV=production
TZ=America/Argentina/Buenos_Aires

# Auth
JWT_SECRET=REEMPLAZAR_POR_SECRETO_LARGO_Y_ALEATORIO
JWT_EXPIRES_IN=7d
JWT_ISSUER=medagenda
JWT_AUDIENCE=medagenda-app

# Multi-tenant por subdominio
BASE_DOMAIN=cymple.online
TRUST_PROXY=true

# CORS: se permite https://BASE_DOMAIN y cualquier subdominio https://*.BASE_DOMAIN
# (se valida por regex en main.ts)

# Evolution API
EVOLUTION_API_URL=https://wap.cymple.online
EVOLUTION_API_KEY=REEMPLAZAR_EVOLUTION_API_KEY
# Token que el backend exige en cada webhook entrante de Evolution.
# La URL configurada en el dashboard de Evolution DEBE incluir este token:
#   https://TU_DOMINIO/v1/webhooks/whatsapp?token=REEMPLAZAR_WEBHOOK_TOKEN
# O bien Evolution debe enviar el header: x-evolution-webhook-token: REEMPLAZAR_WEBHOOK_TOKEN
EVOLUTION_WEBHOOK_TOKEN=REEMPLAZAR_WEBHOOK_TOKEN

# URL pública del backend — necesaria para que al crear una instancia de WhatsApp
# el webhook quede configurado automáticamente con el header de autenticación correcto.
# Sin esta variable el webhook debe configurarse a mano en el dashboard de Evolution.
APP_PUBLIC_URL=https://TU_DOMINIO

