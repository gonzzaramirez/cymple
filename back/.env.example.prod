# ──────────────────────────────────────────────
# Backend — Producción (Dokploy / Docker)
# Copiá este archivo tal cual en Dokploy y reemplazá los valores marcados.
# ──────────────────────────────────────────────

NODE_ENV=production
PORT=3080

# ── Base de datos ─────────────────────────────
# Postgres en Dokploy → hostname del servicio interno (ej: postgres:5432)
# NO usar localhost, usar el nombre del servicio Docker interno
DATABASE_URL="postgresql://postgres:REEMPLAZAR_PASSWORD@REEMPLAZAR_HOST:5432/cymple_prod?schema=public"

# ── JWT ───────────────────────────────────────
# Generar con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=REEMPLAZAR_POR_SECRETO_SEGURO_96_HEX
JWT_EXPIRES_IN=100h

# ── Multi-tenant ──────────────────────────────
# Sin www. ni subdominio — usado para validar CORS y resolver tenant por subdominio
BASE_DOMAIN=cymple.online

# Necesario detrás de reverse proxy (Cloudflare Tunnel / Nginx) para IPs correctas
TRUST_PROXY=true

# ── Evolution API (WhatsApp) ──────────────────
# URL de la API de Evolution (instancia propia o WAP)
EVOLUTION_API_URL=https://wap.cymple.online
EVOLUTION_API_KEY=GympleEvolutionSecret2026

# Token que el backend valida en cada webhook entrante de Evolution
# Debe coincidir con el configurado en el dashboard de Evolution
EVOLUTION_WEBHOOK_TOKEN=GympleEvolutionSecret2026

# URL pública del backend — usada para autoconfigurar webhooks en Evolution
# Cuando creás una instancia, el backend arma la URL del webhook con esto
APP_PUBLIC_URL=https://api.cymple.online

# URL pública del frontend — usada para links que ve el usuario en WhatsApp (intake form, etc.)
FRONTEND_PUBLIC_URL=https://demo.cymple.online
